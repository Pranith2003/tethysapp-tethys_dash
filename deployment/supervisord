#!/usr/bin/python3
# EASY-INSTALL-ENTRY-SCRIPT: 'supervisor==4.2.5','console_scripts','supervisord'
# 🔍 DEBUG: This is the supervisord entry point script
# 📍 Location: /usr/bin/supervisord (or deployment/supervisord)
# 🎯 Purpose: Entry point for Supervisor process manager
import re
import sys

print("🔍 DEBUG: Starting supervisord entry point script")
print(f"📍 DEBUG: Script location: {__file__}")
print(f"📍 DEBUG: Current working directory: {sys.path[0]}")
print(f"📍 DEBUG: Python executable: {sys.executable}")
print(f"📍 DEBUG: Command line arguments: {sys.argv}")

# for compatibility with easy_install; see #2198
__requires__ = 'supervisor==4.2.5'
print(f"🔍 DEBUG: Required supervisor version: {__requires__}")

print("🔍 DEBUG: Attempting to import distribution modules...")
try:
    from importlib.metadata import distribution
    print("✅ DEBUG: Successfully imported importlib.metadata.distribution")
except ImportError:
    print("⚠️  DEBUG: importlib.metadata not available, trying importlib_metadata...")
    try:
        from importlib_metadata import distribution
        print("✅ DEBUG: Successfully imported importlib_metadata.distribution")
    except ImportError:
        print("⚠️  DEBUG: importlib_metadata not available, falling back to pkg_resources...")
        from pkg_resources import load_entry_point
        print("✅ DEBUG: Successfully imported pkg_resources.load_entry_point")


def importlib_load_entry_point(spec, group, name):
    print(f"🔍 DEBUG: importlib_load_entry_point called with spec='{spec}', group='{group}', name='{name}'")
    dist_name, _, _ = spec.partition('==')
    print(f"🔍 DEBUG: Extracted distribution name: '{dist_name}'")
    
    try:
        dist = distribution(dist_name)
        print(f"✅ DEBUG: Found distribution: {dist}")
        print(f"🔍 DEBUG: Looking for entry points with group='{group}' and name='{name}'")
        
        matches = (
            entry_point
            for entry_point in dist.entry_points
            if entry_point.group == group and entry_point.name == name
        )
        
        entry_point = next(matches)
        print(f"✅ DEBUG: Found matching entry point: {entry_point}")
        print(f"🔍 DEBUG: Loading entry point: {entry_point.load}")
        
        loaded_func = entry_point.load()
        print(f"✅ DEBUG: Successfully loaded entry point function: {loaded_func}")
        return loaded_func
        
    except Exception as e:
        print(f"❌ DEBUG: Error in importlib_load_entry_point: {e}")
        raise


print("🔍 DEBUG: Setting up load_entry_point function in globals...")
globals().setdefault('load_entry_point', importlib_load_entry_point)
print("✅ DEBUG: load_entry_point function set in globals")

print("🔍 DEBUG: Checking if script is being run as main...")
if __name__ == '__main__':
    print("✅ DEBUG: Script is running as main - executing supervisord entry point")
    print(f"🔍 DEBUG: Original sys.argv[0]: {sys.argv[0]}")
    
    # Clean up the script name for entry point loading
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    print(f"🔍 DEBUG: Cleaned sys.argv[0]: {sys.argv[0]}")
    
    print("🔍 DEBUG: Loading supervisord entry point...")
    print("📍 DEBUG: Calling load_entry_point('supervisor==4.2.5', 'console_scripts', 'supervisord')")
    
    try:
        # Load and execute the actual supervisord entry point
        supervisord_func = load_entry_point('supervisor==4.2.5', 'console_scripts', 'supervisord')
        print(f"✅ DEBUG: Successfully loaded supervisord function: {supervisord_func}")
        print("🚀 DEBUG: Executing supervisord function...")
        
        exit_code = supervisord_func()
        print(f"🔍 DEBUG: supervisord function completed with exit code: {exit_code}")
        sys.exit(exit_code)
        
    except Exception as e:
        print(f"❌ DEBUG: Error executing supervisord: {e}")
        print(f"❌ DEBUG: Exception type: {type(e).__name__}")
        import traceback
        print(f"❌ DEBUG: Full traceback:\n{traceback.format_exc()}")
        sys.exit(1)
else:
    print("ℹ️  DEBUG: Script imported as module, not executing main block")