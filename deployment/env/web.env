TERM=xterm

# Domain name of server should be first in the list if multiple entries added
ALLOWED_HOSTS="[\"ggst.geoglows.org\",\"54.156.103.67\",\"127.0.0.1\",\"localhost\"]"
CSRF_TRUSTED_ORIGINS="[\"https://ggst.geoglows.org\",\"http://ggst.geoglows.org\",\"http://54.156.103.67\",\"http://127.0.0.1\",\"http://localhost\"]"


# Don't change these parameters
ASGI_PROCESSES=1
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_CONFIG="\"{'hosts':[{'host': 'redis', 'port': 6379}]}\""  # Hostname is the name of the service

# Database parameters
TETHYS_DB_HOST=tethys_db  # Hostname is the name of the service
TETHYS_DB_PORT=5432
TETHYS_DB_ENGINE=django.db.backends.postgresql
TETHYS_DB_NAME=tethys_platform
TETHYS_DB_USERNAME=tethys_default
TETHYS_DB_PASSWORD=postgres
TETHYS_DB_SUPERUSER=tethys_super
TETHYS_DB_SUPERUSER_PASS=postgres
SOCIAL_AUTH_REDIRECT_IS_HTTPS=True

# POSTGRES_PASSWORD should be the same as that in the db.env
POSTGRES_PASSWORD=postgres

# Default admin account for Tethys Portal
PORTAL_SUPERUSER_NAME=admin
PORTAL_SUPERUSER_PASSWORD=postgres
PORTAL_SUPERUSER_EMAIL=you@email.com